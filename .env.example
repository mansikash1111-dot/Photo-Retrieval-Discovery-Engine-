APP_ENV=development

# Database Configuration (SQLite by default, PostgreSQL supported)
DATABASE_URL=sqlite:///./discovery.db

# AI Provider Configuration (Groq API primary for Part 5 MVP, Gemini Flash for Part 1)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# MVP Dataset Settings
DUMMY_PHOTO_COUNT=150

# API Credentials (Optional - system falls back gracefully to public endpoints / demo collectors if missing)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PhotoRetrievalDiscoveryEngine/1.0

YOUTUBE_API_KEY=

# Source Enablement Flags
GOOGLE_PLAY_ENABLED=true
APP_STORE_ENABLED=true
REDDIT_ENABLED=true
GOOGLE_COMMUNITY_ENABLED=true
YOUTUBE_ENABLED=true
FORUMS_ENABLED=true
