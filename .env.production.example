# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# ------------------------------------------
# 1. BACKEND VARIABLES (Set in Railway Dashboard -> Variables)
# ------------------------------------------

# Set application environment to production
APP_ENV=production

# Database URL:
# - If you add a PostgreSQL plugin on Railway, Railway sets DATABASE_URL automatically.
# - If running SQLite with an attached Railway Volume: sqlite:///./discovery.db
DATABASE_URL=sqlite:///./discovery.db

# Groq AI Model & Key (Required for AI queries & intent parsing)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini AI (Optional backup provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Synthetic library size
DUMMY_PHOTO_COUNT=150

# Social API Credentials (Optional - system falls back gracefully to public scrapers/demo datasets if empty)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PhotoRetrievalDiscoveryEngine/1.0
YOUTUBE_API_KEY=

# Source Enablement Flags
GOOGLE_PLAY_ENABLED=true
APP_STORE_ENABLED=true
REDDIT_ENABLED=true
GOOGLE_COMMUNITY_ENABLED=true
YOUTUBE_ENABLED=true
FORUMS_ENABLED=true


# ------------------------------------------
# 2. FRONTEND VARIABLES (Set in Netlify Dashboard -> Site Settings -> Environment variables)
# ------------------------------------------

# Live Railway backend URL (WITHOUT trailing slash)
# Example: https://web-production-xxxx.up.railway.app
VITE_API_URL=https://your-backend-app.up.railway.app
